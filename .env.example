# Copy to .env; never commit your key. Get it at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=45
# Optional USD / million tokens, configured estimates only; blank = unknown cost.
DEEPSEEK_INPUT_PRICE=
DEEPSEEK_OUTPUT_PRICE=
